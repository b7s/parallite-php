{
  "name": "parallite/parallite-php",
  "description": "Execute PHP closures in true parallel using pcntl_fork — zero dependencies",
  "type": "library",
  "keywords": [
    "parallel",
    "php",
    "async",
    "concurrency",
    "parallite",
    "closure",
    "multiprocessing",
    "pcntl",
    "fork"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Bruno Tenorio",
      "email": "b7s@outlook.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-pcntl": "*",
    "ext-posix": "*"
  },
  "require-dev": {
    "b7s/catraca": "^1.0",
    "laravel/pint": "^1.25",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "systemsdk/phpcpd": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "Parallite\\": "src/"
    },
    "files": [
      "src/Support/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:types"
    ],
    "test:types": "@php vendor/bin/phpstan analyse --memory-limit=2G",
    "test:unit": "@php vendor/bin/pest --no-coverage",
    "test:coverage": "@php vendor/bin/pest --coverage"
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
